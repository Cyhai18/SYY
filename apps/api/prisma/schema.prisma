// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id            String         @id @default(uuid())
  phone         String         @unique
  password      String? // bcrypt 哈希，非明文；验证码登录用户可不设置
  email         String?        @unique
  nickname      String         @default("用户")
  avatarUrl     String?
  role          Role           @default(USER)
  status        Int            @default(1) // 1 正常 0 禁用
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  actionLogs    ActionLog[]
  refreshTokens RefreshToken[]

  ownedClients   Client[]          @relation("ClientOwner")
  createdClients Client[]          @relation("ClientCreatedBy")
  updatedClients Client[]          @relation("ClientUpdatedBy")
  certificates   Certificate[]
  importJobs     ClientImportJob[]
  trackedClients ClientTracker[]
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  detail    String?  @db.Text
  ip        String?
  userAgent String?  @db.Text
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([requestId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 客户画像（授权客户）
// ---------------------------------------------------------------------------

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  NORMAL // 正常
  PENDING_RENEWAL // 待续费
  PENDING_REVIEW // 待审核
  // 后续新增状态直接加枚举值 + migration，扩展方式同 Role
}

enum Platform {
  AMAZON
  TEMU
  SHEIN
  TIKTOK
  ALIEXPRESS // 速卖通
  ALIBABA_ICBU // 阿里国际站
  FRUUGO
  OTHER
}

enum AgentCountry {
  GB // 英国
  EU // 欧盟
  US // 美国
  TR // 土耳其
  CA // 加拿大
}

// 代理公司为固定枚举值，与 AgentCountry 一一（或一对多）映射，见 @funtax/shared 的 AGENT_COUNTRY_COMPANIES
enum AgentCompany {
  OVERSEA_WALKERS_GB // 英国 - OVERSEA WALKERS LIMITED
  OVERSEA_WALKERS_EU // 欧盟 - Oversea Walkers
  EU_CONSULTEN_SRLS // 欧盟 - EU Consulten Srls
  OVERSEA_WALKERS_US // 美国 - Oversea Walkers LLC
  OVERSEA_WALKERS_TR // 土耳其 - OVERSEAWALKERS DANISMANLIK LiMiTED SiRKETi
  OVERSEA_WALKERS_CA // 加拿大 - Oversea Walkers
}

enum AttachmentType {
  BUSINESS_LICENSE // 营业执照
  ID_CARD_FRONT // 身份证正面
  ID_CARD_BACK // 身份证反面
  OTHER
}

// 授权客户主表
model Client {
  id               String       @id @default(uuid())
  clientType       ClientType
  phone            String
  email            String?
  remark           String?      @db.Text
  status           ClientStatus @default(PENDING_REVIEW)
  // 客户唯一标识：公司类型存统一社会信用代码，个人类型存身份证号。
  // 提交时与 CompanyInfo.creditCode（仅公司必填）/ LegalRepresentative.idNumber（仅个人必填）保持一致，
  // 但查重/唯一性统一收口在这一列，不再依赖按 clientType 分支去 join 两张子表。
  uniqueIdentifier String       @unique

  ownerId String // 负责该客户的内部员工
  owner   User   @relation("ClientOwner", fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?   @relation("ClientUpdatedBy", fields: [updatedById], references: [id])

  companyInfo  CompanyInfo?
  legalRepInfo LegalRepresentative?
  agentInfos   AgentInfo[]
  attachments  Attachment[]
  trackers     ClientTracker[] // 除 owner 外，可共同跟踪该客户的其他员工

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除

  @@index([ownerId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
}

// 客户跟踪人：一个客户除 owner（主负责人）外，可由多个员工共同跟踪/追加代理信息，
// 权限判断统一收口在 ClientsService.assertAccess()：owner 本人、trackers 名单内、或 ADMIN/SUPERADMIN 均可访问。
model ClientTracker {
  id       String @id @default(uuid())
  clientId String
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}

// 公司主体信息（仅公司类型客户拥有该记录内容；个人类型客户唯一标识见 Client.uniqueIdentifier）
model CompanyInfo {
  id            String  @id @default(uuid())
  clientId      String  @unique
  // 统一社会信用代码，仅公司类型客户必填；与 Client.uniqueIdentifier 保持一致
  creditCode    String?
  nameCn        String?
  nameEn        String?
  addressCn     String? @db.Text
  provinceEn    String?
  cityEn        String?
  postalCode    String?
  addressEn     String? @db.Text // 不含国家/省/市/邮编
  contactPerson String? // 联系人，仅公司类型客户必填
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([nameEn])
}

// 法人信息（个人客户即本人）
model LegalRepresentative {
  id           String  @id @default(uuid())
  clientId     String  @unique
  nameCn       String
  namePinyin   String // 姓名拼音，通过身份证 OCR 识别
  idNumber     String
  idAddressCn  String  @db.Text // 身份证地址（中文），通过身份证 OCR 识别
  idPostalCode String?
  idAddressEn  String? @db.Text // 身份证地址（英文）
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([idNumber])
}

// 代理证书后台自动生成状态机，见 docs/certificate-generation-design.md 异步生成方案
enum CertificateStatus {
  NONE // 尚未触发生成
  PENDING // 已入队，等待 Worker 处理
  GENERATING // Worker 正在生成
  SUCCESS // 生成成功，对应 Certificate 表最新一行
  FAILED // 生成失败，原因见 certificateError
}

// 代理信息（1:N 归属客户；1:N 关联店铺，一份代理协议可覆盖多个店铺）
model AgentInfo {
  id                    String            @id @default(uuid())
  clientId              String
  country               AgentCountry
  expectedEffectiveDate DateTime
  agentYears            Int
  expiresAt             DateTime // = expectedEffectiveDate + agentYears，写入时后端计算
  agentCompany          AgentCompany
  client                Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shops                 Shop[]
  certificates          Certificate[]
  certificateStatus     CertificateStatus @default(NONE)
  certificateError      String?           @db.Text

  createdAt DateTime @default(now())

  @@unique([clientId, country, agentCompany]) // 同一客户禁止重复添加相同的代理国家+代理公司组合
  @@index([clientId])
  @@index([country])
  @@index([expiresAt])
}

// 店铺信息（1:N 归属代理信息；clientId 冗余自 agentInfo.clientId，便于按客户查询；1:N 关联产品）
model Shop {
  id             String    @id @default(uuid())
  agentInfoId    String
  clientId       String
  platform       Platform
  shopId         String? // 平台方店铺 ID
  shopName       String
  shopUrl        String    @db.Text
  brandNames     String    @db.Text // 逗号分隔，无品牌填店铺名
  mainCategoryEn String
  agentInfo      AgentInfo @relation(fields: [agentInfoId], references: [id], onDelete: Cascade)
  products       Product[]

  createdAt DateTime @default(now())

  @@index([agentInfoId])
  @@index([clientId])
  @@index([platform])
}

// 产品信息（非必填，1:N 归属店铺；clientId 冗余自 shop.clientId，便于按客户查询）
model Product {
  id            String   @id @default(uuid())
  shopId        String
  clientId      String
  platform      Platform
  productNameCn String?
  productNameEn String?
  category      String?
  asinOrSku     String? // ASIN码/商品ID
  productUrl    String?  @db.Text
  hasBattery    Boolean  @default(false)
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([clientId])
  @@index([asinOrSku])
}

// 附件：每个客户每种证件类型只保留最新一份（建档/追加代理信息重新上传时覆盖旧记录），
// 见 ClientsService.saveAttachments 的 upsert 实现。
model Attachment {
  id       String         @id @default(uuid())
  clientId String
  type     AttachmentType
  fileUrl  String         @db.Text
  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, type])
  @@index([clientId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// 授权证书生成（见 docs/certificate-generation-design.md）
// ---------------------------------------------------------------------------

// 每次成功生成一份证书落一行记录，兼作生成结果归档
model Certificate {
  id              String    @id @default(uuid())
  agentInfoId     String
  agreementNumber String    @unique // 2026-09-03-0005
  fileUrl         String?   @db.Text // 生成的 PDF 本地磁盘存储路径，后续接入对象存储后改存 URL
  generatedById   String? // 操作人
  agentInfo       AgentInfo @relation(fields: [agentInfoId], references: [id], onDelete: Cascade)
  generatedBy     User?     @relation(fields: [generatedById], references: [id])
  createdAt       DateTime  @default(now())

  @@index([agentInfoId])
  @@index([createdAt])
}

// Agreement Number 按天原子递增计数器，避免并发下"先 COUNT 再 +1"的竞态
model CertificateDailyCounter {
  day String @id // "2026-09-03"
  seq Int    @default(0)
}

// ---------------------------------------------------------------------------
// 授权客户 - 表格模板批量导入（见 docs/client-batch-import-design.md）
// ---------------------------------------------------------------------------

enum ImportJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum ImportItemStatus {
  PENDING
  OCR_PROCESSING
  SUCCESS
  NEEDS_REVIEW
  FAILED
}

// 一次 ZIP 上传 = 一个批次
model ClientImportJob {
  id           String             @id @default(uuid())
  status       ImportJobStatus    @default(QUEUED)
  fileName     String // 原始 ZIP 文件名，便于用户核对
  totalCount   Int                @default(0) // ZIP 内识别到的有效 .xlsx 数量
  successCount Int                @default(0)
  reviewCount  Int                @default(0)
  failedCount  Int                @default(0)
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  items        ClientImportItem[]
  createdAt    DateTime           @default(now())
  finishedAt   DateTime?

  @@index([createdById])
  @@index([status])
}

// 批次内每个 .xlsx 文件的处理状态
model ClientImportItem {
  id           String           @id @default(uuid())
  jobId        String
  job          ClientImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileName     String // ZIP 内的原始文件名，如"张三.xlsx"
  status       ImportItemStatus @default(PENDING)
  clientId     String? // 成功创建后回填，便于跳转详情
  errorReason  String?          @db.Text // FAILED 原因（如"OCR服务不可用""必填字段缺失"）
  reviewFields Json? // NEEDS_REVIEW 时，已识别/已填字段快照，供前端核对表单直接回填
  reviewIssues Json? // NEEDS_REVIEW 具体问题清单，如 [{field:"idNumber", message:"身份证校验位不通过"}]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([jobId])
  @@index([status])
}
