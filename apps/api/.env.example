# 服务监听端口
PORT=3000

# MySQL 连接串，目标数据库需提前手动创建（Prisma migrate 只建表，不建库）
DATABASE_URL="mysql://root:root@localhost:3306/funtax"

# PaddleOCR 微服务地址（客户画像模块 OCR 识别用，代码见仓库 services/ocr-service/）。
# 不配置或该服务未启动时，OCR 识别会优雅降级为"未识别"，不阻断客户新增向导流程，可留空跳过。
# 本地启动步骤见 docs/client-profile-design.md 第 0.2 节 / services/ocr-service/README.md
OCR_SERVICE_URL=http://127.0.0.1:8000

# doc-service 证书生成微服务地址（见 docs/certificate-generation-design.md）。
# 不配置或该服务未启动时，生成证书接口会报错提示，不影响其他功能。
DOC_SERVICE_URL=http://127.0.0.1:8001

# Redis 连接串，BullMQ 批量导入客户队列依赖（见 docs/client-batch-import-design.md）。
# 本地启动步骤见根 README.md「本地依赖」一节；生产环境务必指向真实 Redis 服务，
# 未配置时默认回退到 redis://127.0.0.1:6379（仅适合本地开发）。
REDIS_URL=redis://127.0.0.1:6379
