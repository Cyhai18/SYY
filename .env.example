# 根目录 .env.example，复制为 .env 后按需修改，供 docker-compose.yml 里的 ${VAR} 插值使用。
# 对应宿主机原生 MySQL 里 funtax 用户的密码（见 docs/docker-deploy.md 五、部署步骤 建库建用户）
MYSQL_PASSWORD=changeme

# 对应宿主机原生 Redis 的 requirepass 密码（见 docs/docker-deploy.md 七、数据库/Redis）。
# 生产环境必须配置，api 容器启动时如检测到 REDIS_URL 不带密码会直接报错拒绝运行。
REDIS_PASSWORD=changeme

# 跨域白名单，正式域名，逗号分隔支持多个（见 docs/docker-deploy.md 八、用 .env 管理环境变量）。
CORS_ORIGIN=https://your-domain.com
